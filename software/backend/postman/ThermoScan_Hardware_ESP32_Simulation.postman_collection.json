						"description": "Retorna o histórico de telemetria com timestamp, tensão, corrente, potência, temperaturas e posição X."
					},
					"response": []
				},
				{
					"name": "02. Obter Histórico de Lavagens (SCR-12)",
					"request": {
						"auth": {
