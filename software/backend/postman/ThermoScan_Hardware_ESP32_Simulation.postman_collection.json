{
    "info": {
        "_postman_id": "c1f73b88-5182-41f2-9381-8b01a14eb392",
        "name": "ThermoScan - Simulação de Hardware & Firmware ESP32",
        "description": "Collection oficial para simular o ciclo de vida completo do dispositivo embarcado ESP32 (Wi-Fi, HTTPS REST, Câmera Térmica MLX90640, Sensor Capacitivo de Água, Minibomba e Microswitches NC) comunicando-se com a API Go do ThermoScan.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "00 - Pareamento do Dispositivo (ESP32 Claim)",
            "description": "Fluxo público de claim e pareamento físico da ESP32 com o backend. Retorna o device_token (dev_sec_...) persistente dispensando JWT de técnico.",
            "item": [
                {
                    "name": "01. [ESP32 Boot] Claim do Dispositivo por MAC Address",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var data = pm.response.json();",
                                    "if (data.device_token) {",
                                    "    pm.collectionVariables.set(\"deviceToken\", data.device_token);",
                                    "    pm.collectionVariables.set(\"moduleId\", data.module_id);",
                                    "    console.log(\"Device Token capturado com sucesso:\", data.device_token);",
                                    "    console.log(\"Module ID capturado com sucesso:\", data.module_id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"mac_address\": \"{{macAddress}}\",\n    \"firmware_version\": \"v1.4.2\",\n    \"water_available\": true,\n    \"limits_check_passed\": true,\n    \"thermal_sensor_active\": true\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/devices/claim",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "devices",
                                "claim"
                            ]
                        },
                        "description": "Endpoint público executado pela ESP32 no primeiro boot ou reinício físico. Informa o MAC address e autodiagnóstico inicial. O backend gera o token secreto persistente \"dev_sec_...\" e associa ao módulo, eliminando qualquer dependência de JWT de técnico para a simulação de hardware."
                    },
                    "response": []
                },
                {
                    "name": "02. [Técnico Opcional] Login do Técnico (Obter Token JWT)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var data = pm.response.json();",
                                    "if (data.tokens && data.tokens.access_token) {",
                                    "    pm.collectionVariables.set(\"token\", data.tokens.access_token);",
                                    "    console.log(\"Token JWT atualizado com sucesso!\");",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Realiza login na API Go como Técnico ou Gestor e armazena automaticamente o token de acesso na variável de coleção `token`."
                    },
                    "response": []
                },
                {
                    "name": "03. [Técnico Opcional] Listar Módulos (Identificar ID e MAC)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var data = pm.response.json();",
                                    "if (data.modules && data.modules.length > 0) {",
                                    "    pm.collectionVariables.set(\"moduleId\", data.modules[0].id);",
                                    "    console.log(\"ID do primeiro módulo capturado:\", data.modules[0].id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules"
                            ]
                        },
                        "description": "Lista os módulos autorizados da empresa. Se encontrar módulos, define automaticamente o primeiro na variável `moduleId`."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "01 - Handshake & Conectividade Inicial (ESP32 Boot)",
            "description": "Simula a primeira ligação da placa ESP32 no campo após a montagem mecânica.",
            "item": [
                {
                    "name": "01. Ping Inicial ESP32 (Diagnóstico Completo: Wi-Fi, Água, Interlock e Radiômetro)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"water_available\": true,\n    \"limits_check_passed\": true,\n    \"thermal_sensor_active\": true\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules/{{moduleId}}/device-ping",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules",
                                "{{moduleId}}",
                                "device-ping"
                            ]
                        },
                        "description": "Simula o ping de diagnóstico do ESP32 via HTTPS. Envia o status do sensor capacitivo de água (water_available=true), teste de fim de curso homed (limits_check_passed=true) e sensor radiométrico MLX90640 ativo (thermal_sensor_active=true). No app Flutter, os pontos 2, 3 e 4 do Handshake ficam VERDES simultaneamente."
                    },
                    "response": []
                },
                {
                    "name": "02. Consultar Status do Dispositivo (Checklist Handshake)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules/{{moduleId}}/device-status",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules",
                                "{{moduleId}}",
                                "device-status"
                            ]
                        },
                        "description": "Consulta consumida em polling pela tela de Handshake do Flutter para saber se o módulo está configurado, online e com água disponível."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "02 - Sensores de Nível & Interlocks Físicos",
            "description": "Simula o comportamento do sensor capacitivo de água e a proteção contra operação a seco.",
            "item": [
                {
                    "name": "01. Tanque Vazio (water_available = false)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"water_available\": false,\n    \"limits_check_passed\": true,\n    \"thermal_sensor_active\": true\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules/{{moduleId}}/device-ping",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules",
                                "{{moduleId}}",
                                "device-ping"
                            ]
                        },
                        "description": "Simula o esgotamento do reservatório. A telemetria passa a indicar 'insufficient' e o app exibe aviso para reposição de fluido."
                    },
                    "response": []
                },
                {
                    "name": "02. Tanque Reabastecido (water_available = true)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"water_available\": true,\n    \"limits_check_passed\": true,\n    \"thermal_sensor_active\": true\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules/{{moduleId}}/device-ping",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules",
                                "{{moduleId}}",
                                "device-ping"
                            ]
                        },
                        "description": "Simula o técnico abastecendo o reservatório no módulo. O interlock de segurança da bomba é desarmado e ciclos de lavagem voltam a ser permitidos."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "03 - Telemetria & Varredura Térmica (Passos 2cm - Sobreposição 60%)",
            "description": "Simula o carrinho avançando em passos de 2 cm ao longo do trilho. O sensor MLX90640 (janela de 5 cm) gera sobreposição óptica de 60% (3 cm compartilhados), e o backend compõe o mapa térmico contínuo dividido nas faixas operacionais de 5 cm.",
            "item": [
                {
                    "name": "01. Passo 1: X = 0.0 cm (Início do Painel - Faixa 1 [0-5cm])",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"x_position_cm\": 0.0,\n    \"baseline_temperature_c\": 34.8,\n    \"max_temperature_c\": 37.2,\n    \"hotspot_detected\": false,\n    \"hotspot_confirmed\": false,\n    \"voltage_v\": 18.6,\n    \"current_a\": 4.4\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules/{{moduleId}}/telemetry",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules",
                                "{{moduleId}}",
                                "telemetry"
                            ]
                        },
                        "description": "Primeira captura na posição X = 0.0 cm (origem/fim de curso). Registra leitura normal na Faixa 1 (0-5 cm)."
                    },
                    "response": []
                },
                {
                    "name": "02. Passo 2: X = 2.0 cm (Avanço 2cm - Sobreposição 60%)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"x_position_cm\": 2.0,\n    \"baseline_temperature_c\": 35.0,\n    \"max_temperature_c\": 37.5,\n    \"hotspot_detected\": false,\n    \"hotspot_confirmed\": false,\n    \"voltage_v\": 18.5,\n    \"current_a\": 4.3\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules/{{moduleId}}/telemetry",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules",
                                "{{moduleId}}",
                                "telemetry"
                            ]
                        },
                        "description": "Avanço de 2.0 cm pelo motor de passo. O frame compartilha 3 cm de sobreposição com a captura anterior (60% overlap)."
                    },
                    "response": []
                },
                {
                    "name": "03. Passo 3: X = 4.0 cm (Avanço 2cm - Faixa 1 e 2)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"x_position_cm\": 4.0,\n    \"baseline_temperature_c\": 35.0,\n    \"max_temperature_c\": 38.0,\n    \"hotspot_detected\": false,\n    \"hotspot_confirmed\": false,\n    \"voltage_v\": 18.4,\n    \"current_a\": 4.3\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules/{{moduleId}}/telemetry",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules",
                                "{{moduleId}}",
                                "telemetry"
                            ]
                        },
                        "description": "Avanço para X = 4.0 cm transicionando da Faixa 1 para a Faixa 2."
                    },
                    "response": []
                },
                {
                    "name": "04. Passo 4: X = 6.0 cm (Hotspot Crítico na Faixa 2 [5-10cm])",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"x_position_cm\": 6.0,\n    \"baseline_temperature_c\": 35.0,\n    \"max_temperature_c\": 58.4,\n    \"hotspot_detected\": true,\n    \"hotspot_confirmed\": true,\n    \"voltage_v\": 16.2,\n    \"current_a\": 3.8\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules/{{moduleId}}/telemetry",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules",
                                "{{moduleId}}",
                                "telemetry"
                            ]
                        },
                        "description": "Simula a detecção de um ponto quente crítico (58.4°C vs 35.0°C baseline = delta 23.4°C) na Faixa 2 (5-10 cm). A ESP32 identifica o hotspot localmente, registra a anomalia e posiciona o bocal."
                    },
                    "response": []
                },
                {
                    "name": "05. Ingestão em Lote (Varredura Completa - Passos de 2cm)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"batch\": [\n        {\"x_position_cm\": 0.0, \"baseline_temperature_c\": 34.8, \"max_temperature_c\": 37.0, \"hotspot_detected\": false, \"voltage_v\": 18.6, \"current_a\": 4.4},\n        {\"x_position_cm\": 2.0, \"baseline_temperature_c\": 35.0, \"max_temperature_c\": 37.5, \"hotspot_detected\": false, \"voltage_v\": 18.5, \"current_a\": 4.3},\n        {\"x_position_cm\": 4.0, \"baseline_temperature_c\": 35.0, \"max_temperature_c\": 38.0, \"hotspot_detected\": false, \"voltage_v\": 18.4, \"current_a\": 4.3},\n        {\"x_position_cm\": 6.0, \"baseline_temperature_c\": 35.0, \"max_temperature_c\": 58.4, \"hotspot_detected\": true, \"hotspot_confirmed\": true, \"voltage_v\": 16.2, \"current_a\": 3.8},\n        {\"x_position_cm\": 8.0, \"baseline_temperature_c\": 35.0, \"max_temperature_c\": 42.0, \"hotspot_detected\": false, \"voltage_v\": 17.5, \"current_a\": 4.1},\n        {\"x_position_cm\": 10.0, \"baseline_temperature_c\": 34.9, \"max_temperature_c\": 37.2, \"hotspot_detected\": false, \"voltage_v\": 18.5, \"current_a\": 4.3}\n    ]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules/{{moduleId}}/telemetry",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules",
                                "{{moduleId}}",
                                "telemetry"
                            ]
                        },
                        "description": "Ingere a varredura completa da inspeção em lote. O backend executa o algoritmo de sobreposição ponderada de 60%, divide nas faixas de 5 cm (Faixa 1 [0-5cm], Faixa 2 [5-10cm], Faixa 3 [10-15cm]) e gera o mapa térmico composto final."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "04 - Atuação Mecânica & Ciclos de Lavagem",
            "description": "Simula o atuador motorizado, bocal aspersor e minibomba executando o protocolo de limpeza.",
            "item": [
                {
                    "name": "01. Relatório de Lavagem com Sucesso (Tentativa 1)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"target_x_position_cm\": 24.2,\n    \"pump_actuated\": true,\n    \"attempt_number\": 1,\n    \"duration_seconds\": 45.0,\n    \"estimated_water_volume_ml\": 80.0,\n    \"status\": \"completed\",\n    \"post_cleaning_result\": \"resolved\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules/{{moduleId}}/cleanings",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules",
                                "{{moduleId}}",
                                "cleanings"
                            ]
                        },
                        "description": "Registra que o bocal se deslocou até a posição do hotspot (X=24.2 cm), a bomba atuou por 45s consumindo ~80ml e a inspeção pós-limpeza constatou anomalia sanada ('resolved'). Aparece na tela de Histórico de Lavagens (SCR-12)."
                    },
                    "response": []
                },
                {
                    "name": "02. Recusa de Lavagem por Falta d'Água (Interlock Ativado)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"target_x_position_cm\": 24.2,\n    \"pump_actuated\": false,\n    \"duration_seconds\": 0.0,\n    \"estimated_water_volume_ml\": 0.0,\n    \"status\": \"refused\",\n    \"failure_reason\": \"Recusa de segurança: sensor capacitivo detectou nível seco no reservatório\",\n    \"post_cleaning_result\": \"unresolved\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules/{{moduleId}}/cleanings",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules",
                                "{{moduleId}}",
                                "cleanings"
                            ]
                        },
                        "description": "Simula o firmware recusando o ciclo de lavagem para proteger a bomba contra funcionamento a seco. No app, aparece registrado com status REFUSED e motivo detalhado."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "05 - Leituras & Consultas do Módulo",
            "description": "Rotas GET idênticas às que o aplicativo Flutter consome para renderizar os dados na tela.",
            "item": [
                {
                    "name": "01. Obter Histórico de Medições (SCR-11)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules/{{moduleId}}/measurements?limit=20&offset=0",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules",
                                "{{moduleId}}",
                                "measurements"
                            ],
                            "query": [
                                {
                                    "key": "limit",
                                    "value": "20"
                                },
                                {
                                    "key": "offset",
                                    "value": "0"
                                }
                            ]
                        },
                        "description": "Retorna o histórico de telemetria com timestamp, tensão, corrente, potência, temperaturas e posição X."
                    },
                    "response": []
                },
                {
                    "name": "02. Obter Histórico de Lavagens (SCR-12)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/modules/{{moduleId}}/cleanings?limit=20&offset=0",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "modules",
                                "{{moduleId}}",
                                "cleanings"
