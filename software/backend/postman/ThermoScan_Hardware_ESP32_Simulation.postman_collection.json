							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"modules",
								"{{moduleId}}",
								"thermal-map"
							]
						},
						"description": "Retorna a matriz termográfica interpolada gerada para a última inspeção do módulo."
					},
					"response": []
				}
			]
		}
