							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"modules",
								"{{moduleId}}",
								"cleanings"
							],
							"query": [
								{
									"key": "limit",
									"value": "20"
								},
								{
									"key": "offset",
									"value": "0"
								}
							]
						},
						"description": "Retorna todos os registros de acionamento do atuador de lavagem, volumes de água e resultado pós-lavagem."
					},
					"response": []
				},
				{
					"name": "03. Obter Mapa Térmico Composto",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
